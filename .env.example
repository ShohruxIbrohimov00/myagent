# ============================================================
#  SHOHRUX AI AGENT - sozlamalar
#  Bu faylni .env deb nusxa oling va qiymatlarni to'ldiring
# ============================================================

# --- Telegram bot (boshqaruv / admin) ---
# @BotFather dan olinadi
BOT_TOKEN=123456:ABC-bot-token-bu-yerga

# Sizning Telegram raqamli ID'ingiz (faqat shu odam botni boshqaradi)
# @userinfobot ga yozsangiz ID'ingizni aytadi
ADMIN_ID=123456789

# Bot post tashlaydigan SIZNING kanalingiz (@username yoki -100... ID)
# Botni o'sha kanalga admin qilib qo'ying
TARGET_CHANNEL=@mening_kanalim

# --- Telethon (manba kanallarni o'qish uchun, SIZNING akkauntingiz) ---
# https://my.telegram.org -> API development tools dan olinadi
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# --- Manba kanallar (vergul bilan ajrating) ---
# Ochiq kanallar: @username ko'rinishida. Yopiq kanallar: akkauntingiz a'zo bo'lsa ID/username
SOURCE_CHANNELS=@kanal1,@kanal2,@kanal3

# --- Gemini API kalitlari (vergul bilan, 10-20 ta qo'ysangiz bo'ladi) ---
# https://aistudio.google.com/app/apikey dan tekin olinadi
GEMINI_API_KEYS=key1,key2,key3

# Model nomi (tekin limit yaxshi bo'lgan model)
GEMINI_MODEL=gemini-1.5-flash

# Yangi postlarni necha soniyada bir tekshirish (avtomatik tekshiruv)
POLL_INTERVAL=120
